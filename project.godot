;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Oristaile"
run/main_scene="uid://c7u2v2cos0fp0"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=500
config/icon="res://icon.svg"

[autoload]

CardData="*uid://iusw0xktf8om"
RunData="*uid://s8hkm7luknm8"
Preloads="*uid://d2eevwte31daa"
SignalBus="*uid://deabi331ia56d"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Data/": "teal",
"res://Fonts/": "gray",
"res://Resources/": "green",
"res://Scenes/": "pink",
"res://Scripts/": "blue"
}

